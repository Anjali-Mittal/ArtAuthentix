<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("./partials/head") %>
    <title>ArtAuthentix</title>
    <style>
      .painting-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .painting-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
      }

      .card-img-top {
        height: 240px;
        object-fit: cover;
      }

      .username {
        font-size: 0.9rem;
        color: #555;
      }

      .upload-date {
        font-size: 0.8rem;
        color: #888;
      }
    </style>
  </head>

  <body>
    <%- include("./partials/nav") %>
    <div class="container mt-4">
      <h2 class="mb-4">Our Paintings</h2>
      <% if (!images || images.length === 0) { %>
        <!-- EMPTY STATE -->
        <div class="text-center mt-5">
          <h4>No paintings yet</h4>
          <p class="text-muted">
            Upload your Artwork to see style analysis results.
          </p>
          <a href="/painting/upload" class="btn btn-primary mt-2">
            Upload Painting
          </a>
        </div>
      <% } else { %>
        <div class="row">
          <% images.forEach(img => { %>
            <div class="col-md-4 mb-4">
              <div class="card painting-card h-100">
                <!-- IMAGE -->
                <img src="<%= img.imageUrl %>" class="card-img-top"
                alt="Painting"
                />
                <!-- BODY -->
                <div class="card-body d-flex flex-column">

                  <!-- META -->
                  <small class="text-muted mb-2">
                    Uploaded <%= img.createdAt.toLocaleDateString() %>
                    by <% if (img.userId) { %>
                        <a href="/user/<%= img.userId._id %>/profile"
                        class="text-decoration-none fw-semibold">
                        <%= img.userId.fullName %>
                        </a>
                      <% } else { %>
                            Unknown User
                        <% } %>
                    </small>
                  <!-- ACTIONS -->
                  <div class="mt-auto d-flex justify-content-between align-items-center gap-2">

                    <!-- UPVOTE -->
                  <% if (user) { %>
                    <button
                        type="button"
                        class="btn btn-sm <%= img.upvotedBy.map(id => id.toString()).includes(user._id.toString())
                        ? 'btn-success': 'btn-outline-success' %>"
                        onclick="toggleUpvote('<%= img._id %>', this)">▲ <span><%= img.upvotes %></span>
                    </button>

                    <% } %>

                    <!-- VIEW -->
                    <a
                      href="/painting/<%= img._id %>/results"
                      class="btn btn-sm btn-outline-primary"
                    >
                      View
                    </a>

                    <!-- DELETE (OWNER ONLY) -->
                    <% if (user && img.userId && user._id.toString() === img.userId._id.toString()) { %>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="deletePainting('<%= img._id %>')">
                               Delete
                        </button>

                    <% } %>

                  </div>
                </div>

              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>

    <%- include("./partials/scripts") %>
    <script>
      async function deletePainting(paintingId) {
        if (!confirm("Delete this painting?")) return;
        try {
          const res = await fetch(`/painting/${paintingId}`, {
          method: "DELETE",
            headers: {
              "Accept": "application/json"
            }
          });
          const data = await res.json();
      if (res.ok) {
        location.reload();
      } else {
        alert(data.error || "Delete failed");
      }
    } catch (err) {
      console.error(err);
      alert("Network error while deleting painting");
    }
  }
    
      async function toggleUpvote(paintingId, button) {
    try {
      const res = await fetch(`/painting/${paintingId}/upvote`, {
        method: "POST"
      });

      if (!res.ok) return;

      const data = await res.json();

      // Update count
      button.querySelector("span").innerText = data.upvotes;

      // Toggle green state
      if (data.isUpvoted) {
        button.classList.remove("btn-outline-success");
        button.classList.add("btn-success");
      } else {
        button.classList.remove("btn-success");
        button.classList.add("btn-outline-success");
      }
    } catch (err) {
      console.error("Upvote error", err);
    }
  }
    </script>

  </body>
</html>
