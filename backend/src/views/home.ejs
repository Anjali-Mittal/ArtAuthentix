<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Homepage</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <h4 class="mt-4">Recently Processed Images</h4>

  <div class="row">
    <% images.forEach(img => { %>
      <div class="col-md-3 mb-3">
        <img 
          src="/uploads/<%= img.imagePath %>"
          class="img-fluid rounded"
          alt="uploaded image"
        >
      </div>
    <% }) %>
  </div>

    <%- include('./partials/scripts') %>
  </body>
</html>
