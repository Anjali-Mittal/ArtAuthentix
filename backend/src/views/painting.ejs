<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
    <title>Upload Painting</title>
  </head>
  <body>
    <%- include('./partials/nav') %>
    <div class="container mt-3">
        <% if (error) { %>
            <div class="alert alert-danger">
        <%= error %>
            </div>
    <% } %>
        <form action="/painting/upload" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="image" class="form-label">Painting</label>
                <input type="file" class="form-control" id="image" name="image" aria-describedby="image">
            </div>
            <div class="mb-3">
                <button class="btn btn-primary" type="submit">
                    Submit</button>
            </div>
        </form>
    </div>
    <%- include('./partials/scripts') %>
  </body>
</html>
